rules_version = '2';

// Regles de Firestore del projecte remigi-c37ac: rànquings de la partida del dia
// i desat privat del nivell i la lliga en curs.
// S'enganxen a la consola: Firestore Database → Reglas → Publicar.
// Explicació a docs/PARTIDA-DEL-DIA.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function validAlias(alias) {
      return alias is string && alias.size() >= 1 && alias.size() <= 24;
    }

    function count(n, max) {
      return n is int && n >= 0 && n <= max;
    }

    function isDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // La puntuació del rànquing (menys, millor), amb el desempat: victòria,
    // jugades × 1000 + (999 − punts dels rivals); derrota, 1.000.000 +
    // punts × 1000 + jugades.
    function tieBreakScore(d) {
      return count(d.rivals, 999)
        && (
          (d.won == true && d.score == d.moves * 1000 + 999 - d.rivals)
          || (d.won == false && d.score == 1000000 + d.points * 1000 + d.moves)
        );
    }

    // La puntuació d'abans del desempat (resultats sense `rivals`).
    function legacyScore(d) {
      return (d.won == true && d.score == d.moves)
        || (d.won == false && d.score == 1000 + d.points);
    }

    // El resultat de cada jugador cada dia: tothom el pot llegir; només el
    // propi jugador el pot crear, un sol cop, i no es pot canviar ni esborrar.
    match /dia/{day}/resultats/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isDay(day)
        && request.resource.data.keys().hasOnly(['alias', 'won', 'moves', 'points', 'rivals', 'score', 'streak', 'at'])
        && validAlias(request.resource.data.alias)
        && request.resource.data.won is bool
        && count(request.resource.data.moves, 999)
        && request.resource.data.moves >= 1
        && count(request.resource.data.points, 2000)
        && count(request.resource.data.streak, 100000)
        && (
          ('rivals' in request.resource.data && tieBreakScore(request.resource.data))
          || (!('rivals' in request.resource.data) && legacyScore(request.resource.data))
        )
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // L'àlies i la ratxa de cada jugador: tothom els pot llegir; només el
    // propi jugador els pot escriure o esborrar.
    match /jugadors/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alias', 'streak', 'bestStreak', 'lastDay', 'at'])
        && validAlias(request.resource.data.alias)
        && count(request.resource.data.streak, 100000)
        && count(request.resource.data.bestStreak, 100000)
        && request.resource.data.streak <= request.resource.data.bestStreak
        && request.resource.data.lastDay is string
        && isDay(request.resource.data.lastDay)
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // El desat privat de cada jugador: nom, nivell i lliga en curs (cap
    // historial). Només el propi jugador el pot llegir, escriure o esborrar.
    match /perfils/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'name', 'level', 'league', 'at'])
        && request.resource.data.version == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.level is map
        && request.resource.data.level.keys().hasOnly(['rating', 'gamesPlayed', 'wins', 'ratedGames', 'adaptiveStep', 'adaptiveCalibrating'])
        && request.resource.data.league is map
        && request.resource.data.league.keys().hasOnly(['career', 'season', 'seasonsPlayed'])
        && request.resource.data.at == request.time;
    }

    // La fotografia de la classificació de cada dia: tothom la pot llegir;
    // només l'escriu la tasca programada (amb la clau de servei, que no passa
    // per aquestes regles).
    match /classificacio/{day} {
      allow read: if true;
      allow write: if false;
    }

    // Tota la resta, tancat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
