rules_version = '2';

// Regles de Firestore del projecte remigi-c37ac (rànquings de la partida del dia).
// S'enganxen a la consola: Firestore Database → Reglas → Publicar.
// Explicació a docs/PARTIDA-DEL-DIA.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function validAlias(alias) {
      return alias is string && alias.size() >= 1 && alias.size() <= 24;
    }

    function count(n, max) {
      return n is int && n >= 0 && n <= max;
    }

    function isDay(day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // El resultat de cada jugador cada dia: tothom el pot llegir; només el
    // propi jugador el pot crear, un sol cop, i no es pot canviar ni esborrar.
    match /dia/{day}/resultats/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isDay(day)
        && request.resource.data.keys().hasOnly(['alias', 'won', 'moves', 'points', 'score', 'streak', 'at'])
        && validAlias(request.resource.data.alias)
        && request.resource.data.won is bool
        && count(request.resource.data.moves, 999)
        && request.resource.data.moves >= 1
        && count(request.resource.data.points, 2000)
        && count(request.resource.data.streak, 100000)
        && (
          (request.resource.data.won == true && request.resource.data.score == request.resource.data.moves)
          || (request.resource.data.won == false && request.resource.data.score == 1000 + request.resource.data.points)
        )
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // L'àlies i la ratxa de cada jugador: tothom els pot llegir; només el
    // propi jugador els pot escriure o esborrar.
    match /jugadors/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alias', 'streak', 'bestStreak', 'lastDay', 'at'])
        && validAlias(request.resource.data.alias)
        && count(request.resource.data.streak, 100000)
        && count(request.resource.data.bestStreak, 100000)
        && request.resource.data.streak <= request.resource.data.bestStreak
        && request.resource.data.lastDay is string
        && isDay(request.resource.data.lastDay)
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Tota la resta, tancat.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
