{
  "name": "rummikub",
  "private": true,
  "description": "Rummikub contra oponents IA amb dificultat adaptativa",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rummikub/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview -w @rummikub/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "simulate": "npm run simulate -w @rummikub/core --"
  }
}
